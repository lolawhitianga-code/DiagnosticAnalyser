<!--
  Type-checks the WPF ViewModels on a machine that cannot build WPF.

  Ubuntu's .NET SDK has no Microsoft.NET.Sdk.WindowsDesktop targets, so
  DiagFileMonitor.App will not compile there at all. This project pulls in the
  real WindowsDesktop reference assemblies via FrameworkReference and compiles
  the ViewModels, converters and services as a plain library - no XAML, no
  UseWPF, no UseWindowsForms (setting either imports the targets Ubuntu lacks).

  It catches every C# error in the ViewModels. It cannot catch XAML errors;
  check_xaml.py covers those.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />

    <!--
      The real App project sets UseWPF and UseWindowsForms, and each of those adds its own
      namespaces to the implicit usings. Setting those properties here would import the targets
      Ubuntu lacks, so the usings are added by hand instead.

      This is not tidiness. Without it the two sets never collide here, and every ambiguity between
      them - Cursor, Brush, Color, KeyEventArgs and more exist in both - compiles cleanly on Linux
      and fails on Windows. That happened; hence this block.

      The list is tuned to match the real build rather than to the documentation: System.Windows.Shapes
      is deliberately absent, because with it Path.Combine is ambiguous everywhere and the Windows
      build has no such trouble. If a real build ever fails on an ambiguity this does not reproduce,
      add the namespace here so the next one is caught before it ships.
    -->
    <Using Include="System.Windows" />
    <Using Include="System.Windows.Controls" />
    <Using Include="System.Windows.Data" />
    <Using Include="System.Windows.Documents" />
    <Using Include="System.Windows.Input" />
    <Using Include="System.Windows.Media" />
    <Using Include="System.Drawing" />
    <Using Include="System.Windows.Forms" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DiagFileMonitor.Core/DiagFileMonitor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/DiagFileMonitor.App/ViewModels/*.cs" />
    <Compile Include="../../src/DiagFileMonitor.App/Converters/*.cs" />
    <Compile Include="../../src/DiagFileMonitor.App/Services/*.cs" />
    <!--
      The help popup and its mode are written in plain C# rather than XAML precisely so they can
      be type-checked here. Anything written in XAML ships unverified on this box.
    -->
    <Compile Include="../../src/DiagFileMonitor.App/Help/*.cs" />
  </ItemGroup>
</Project>
