<Window x:Class="DiagFileMonitor.App.AnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="clr-namespace:DiagFileMonitor.App.Help"
        Title="Diagnostic analysis" Height="700" Width="1220"
        MinHeight="400" MinWidth="620"
        Background="{StaticResource AppBackground}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <DockPanel>
            <Button DockPanel.Dock="Top" x:Name="HelpModeButton" Style="{StaticResource HelpButton}"
                    HorizontalAlignment="Right" Margin="0,0,0,4" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Copy to clipboard" help:Help.Topic="analysis.copy" Command="{Binding CopyCommand}" Width="130" Margin="0,0,6,0"
                        Style="{StaticResource PrimaryButton}" />
                <Button Content="Close" help:Help.Topic="common.close" Click="Close_Click" Width="90" IsCancel="True" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" Style="{StaticResource SectionHeading}"
                       Margin="0,0,0,8" TextWrapping="Wrap" />

            <!-- Reference photos from solved cases, when the report's finding matches one. -->
            <Border DockPanel.Dock="Right" Width="320" Margin="10,0,0,0" Padding="10"
                    Style="{StaticResource Panel}"
                    Visibility="{Binding HasReferences, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Reference photos" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ReferenceTitle}" TextWrapping="Wrap" Margin="0,2,0,4" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ReferenceSummary}" TextWrapping="Wrap"
                               FontSize="11" Opacity="0.75" Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ReferencePhotos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <Button help:Help.Topic="analysis.photo"
                                                Command="{Binding DataContext.OpenPhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand" Padding="0" BorderThickness="0" Background="Transparent"
                                                ToolTip="Click to see it full size">
                                            <Image Source="{Binding Source}" Stretch="Uniform" MaxHeight="320" />
                                        </Button>
                                        <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Panel}" Padding="0">
                <TextBox Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12"
                         BorderThickness="0" Background="Transparent"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Padding="10" />
            </Border>
        </DockPanel>

        <!-- One photo full size over the report. -->
        <Border Background="#E6101010"
                Visibility="{Binding HasEnlargedPhoto, Converter={StaticResource BoolToVisibility}}">
            <DockPanel Margin="20">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="Close photo" help:Help.Topic="analysis.photoclose"
                            Command="{Binding ClosePhotoCommand}" Width="110" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding EnlargedPhoto.Caption}" Foreground="White" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontSize="13" />
                </DockPanel>
                <Image Source="{Binding EnlargedPhoto.Source}" Stretch="Uniform" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
