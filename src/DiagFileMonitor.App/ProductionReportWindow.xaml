<Window x:Class="DiagFileMonitor.App.ProductionReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="clr-namespace:DiagFileMonitor.App.Help"
        Title="Production reports" Height="700" Width="900"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackground}">
    <DockPanel Margin="12">
        <Button DockPanel.Dock="Top" x:Name="HelpModeButton" Style="{StaticResource HelpButton}"
                HorizontalAlignment="Right" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" Text="Production reports" Style="{StaticResource WordmarkPrimary}"
                   Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource BrandGrey}"
                   Margin="0,0,0,10"
                   Text="Reads ProdLogV2 weekly logs into this PC's database and builds a production report from what is stored. Logs are read once and kept, so a report covering a year does not re-read a year of files." />

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel}" Margin="0,10,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" help:Help.Topic="common.close" Width="90" Margin="8,0,0,0"
                        Click="Close_Click" />
                <Button DockPanel.Dock="Right" Content="Open it" help:Help.Topic="production.build" Width="90"
                        Command="{Binding OpenReportCommand}" />
                <Button DockPanel.Dock="Right" Content="Build report" help:Help.Topic="production.build" Width="130" Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding BuildCommand}" />
                <Button DockPanel.Dock="Right" Content="Import logs" help:Help.Topic="production.import" Width="110" Margin="0,0,8,0"
                        Command="{Binding ImportCommand}" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Which machine" help:Help.Topic="production.machine" Style="{StaticResource SectionHeading}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrandGrey}" Margin="0,0,0,8"
                                   Text="ProdLogV2 files carry no machine identity at all - not in the file, not in the file name. Browsing to a folder reads the serial out of the folder name where there is one; otherwise type it. It is what the stored weeks are filed under." />

                        <TextBlock Text="Serial number" Margin="0,0,0,4" />
                        <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10" />

                        <TextBlock Text="Machine name for the report title" Margin="0,0,0,4" />
                        <TextBox Text="{Binding MachineName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10" />

                        <TextBlock Text="Site" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Site, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Import weekly logs" Style="{StaticResource SectionHeading}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrandGrey}" Margin="0,0,0,8"
                                   Text="Point this at a folder of ProdLogV2 files. Sub-folders are read too, and a week already stored is skipped rather than counted twice. Tick the box below if you are pointing at a parent folder with one folder per machine." />

                        <TextBlock Text="Folder" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="Browse..." help:Help.Topic="production.browse" Width="90" Margin="8,0,0,0"
                                    Command="{Binding BrowseForFolderCommand}" />
                            <TextBox Text="{Binding LogFolder, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Text="{Binding FolderHint}" help:Help.Topic="production.folderhint" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrandGrey}" Margin="0,0,0,8" />

                        <CheckBox Content="Each sub-folder is a different machine, named by its serial" help:Help.Topic="production.subfolders"
                                  IsChecked="{Binding EachSubfolderIsAMachine}" Margin="0,0,0,4" />
                        <CheckBox Content="Re-read weeks already stored, replacing them" help:Help.Topic="production.replace"
                                  IsChecked="{Binding ReplaceExisting}" Margin="0,0,0,10" />

                        <TextBlock Text="Already stored" help:Help.Topic="production.stored" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding StoredSummary, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11" Height="70"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" />
                        <Button Content="Refresh" help:Help.Topic="production.refresh" Width="90" HorizontalAlignment="Left"
                                Command="{Binding RefreshStoredCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Shift model" help:Help.Topic="production.shift" Style="{StaticResource SectionHeading}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrandGrey}" Margin="0,0,0,8"
                                   Text="Availability is worked out from this, not measured. Two machines only compare on availability if they are on the same model, and the report prints whichever one was used." />
                        <ComboBox ItemsSource="{Binding ShiftModelOptions}" SelectedIndex="{Binding ShiftModelIndex}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
