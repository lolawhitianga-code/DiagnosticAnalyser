<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DiagFileMonitor</AssemblyName>
    <RootNamespace>DiagFileMonitor.App</RootNamespace>

    <!-- Shown on the splash and in the header. Bump this when you cut a build for the floor. -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiagFileMonitor.Core\DiagFileMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The logo ships inside the exe so a fresh build looks right with nothing to copy.
      A logo.png beside the exe still wins over it - see BrandLogo.
    -->
    <Resource Include="Assets\logo.png" />

    <!--
      The help text ships inside the exe so a fresh build has working help with nothing to copy.
      Linked rather than copied, so docs/HELP.md stays the single source. A HELP.md beside the exe
      still wins over this - see HelpLibrary.
    -->
    <Resource Include="..\..\docs\HELP.md" Link="Assets\HELP.md" />

    <!--
      Reference photos from solved cases, shown beside a report whose finding matches. Linked from
      docs/cases so the write-up and the app share one copy of each picture.
    -->
    <Resource Include="..\..\docs\cases\M21856\1-before-sensor-too-far.jpg" Link="Assets\References\home-sensor-too-far.jpg" />
    <Resource Include="..\..\docs\cases\M21856\2-after-sensor-1-2mm.jpg" Link="Assets\References\home-sensor-correct.jpg" />
  </ItemGroup>

</Project>
